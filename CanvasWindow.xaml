<Window x:Class="ScreenCaptureApp.CanvasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenCaptureApp.Controls"
        Title="Canvas Window" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseDown="CanvasWindow_MouseDown"
        Activated="CanvasWindow_Activated">
    
    <Grid>
        <!-- Background Image -->
        <Image x:Name="BackgroundImage" 
               Stretch="None" 
               HorizontalAlignment="Left" 
               VerticalAlignment="Top"
               Panel.ZIndex="0"
               IsHitTestVisible="False"/>
        
        <!-- InkCanvas для обычного рисования -->
        <InkCanvas x:Name="DrawingCanvas" 
                   Background="Transparent"
                   Panel.ZIndex="1"
                   IsHitTestVisible="True"
                   EditingMode="Ink"/>
        
        
        <Rectangle x:Name="CanvasBorder"
                   IsHitTestVisible="False"
                   StrokeThickness="2"
                   StrokeDashArray="4,2,1,2"
                   Margin="0"
                   SnapsToDevicePixels="True"
                   Fill="Transparent"
                   Panel.ZIndex="2"/>
        
        <!-- Active Symbol Display -->
        <Border x:Name="ActiveSymbolBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Background="#CC222222"
                BorderBrush="Black"
                BorderThickness="2"
                Padding="8,4"
                Panel.ZIndex="3">
            <TextBlock x:Name="ActiveSymbolText"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Yellow"
                       Text=""
                       IsHitTestVisible="False"/>
        </Border>
        
        <!-- Copy to Clipboard Button -->
        <Button x:Name="CopyImageButton"
                Content="📋"
                Width="32" Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="150,10,0,0"
                Click="CopyImageButton_Click"
                ToolTip="Скопировать картинку в буфер"
                Background="#CC222222" Foreground="White"
                BorderBrush="Black" BorderThickness="1"
                FontSize="16"
                Panel.ZIndex="3"/>
        
        <TextBlock x:Name="TimerText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="10"
                   FontSize="24"
                   Foreground="White"
                   Background="#80000000"
                   Padding="8,4"
                   Text=""
                   Panel.ZIndex="3"
                   IsHitTestVisible="False"/>

        <!-- Центральный индикатор Trading Mode с брокером и риском -->
        <controls:TradingToolbar x:Name="TradingToolbar" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Top" 
                                 Panel.ZIndex="3"
                                 Visibility="Collapsed" />

        <!-- Canvas Trading Toolbar - показывается при наличии открытых сделок -->
        <controls:CanvasTradingToolBar x:Name="CanvasTradingToolBar" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Top" 
                                       Margin="0,10,0,0"
                                       Panel.ZIndex="4"
                                       Visibility="Collapsed" />

        <!-- Canvas Tracking List - показывает список трекающихся CaptureData -->
        <controls:CanvasTrackingList x:Name="CanvasTrackingList" 
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Top" 
                                     Margin="0,5,0,0"
                                     Panel.ZIndex="5" />

        <!-- Дублирующая надпись TradingModeText внизу -->
        <TextBlock
            Text="{Binding ElementName=TradingModeText, Path=Text}"
            Visibility="{Binding ElementName=TradingModeText, Path=Visibility}"
            FontSize="32"
            FontWeight="Bold"
            Foreground="Red"
            Background="#AA000000"
            Padding="10,0"
            TextAlignment="Center"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0"
            Panel.ZIndex="3"
            IsHitTestVisible="False"/>
    </Grid>
</Window> 