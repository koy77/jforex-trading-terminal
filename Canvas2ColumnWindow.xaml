<Window x:Class="ScreenCaptureApp.Canvas2ColumnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenCaptureApp.Controls"
        Title="Canvas 2-Column Window" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseDown="Canvas2ColumnWindow_MouseDown"
        Activated="Canvas2ColumnWindow_Activated">
    
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка для MT4 -->
            <ColumnDefinition x:Name="Mt4Column" Width="Auto"/>
            <!-- Правая колонка для GeForce -->
            <ColumnDefinition x:Name="GeForceColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- MT4 область (левая колонка) -->
        <Grid Grid.Column="0" x:Name="Mt4Area" Background="Transparent" ClipToBounds="True">
            <!-- MT4 Background Image -->
            <Image x:Name="Mt4BackgroundImage" 
                   Stretch="None" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Panel.ZIndex="0"
                   IsHitTestVisible="False"
                   Visibility="Collapsed"/>
            
            <!-- InkCanvas для рисования поверх MT4 -->
            <InkCanvas x:Name="Mt4DrawingCanvas" 
                       Background="Transparent"
                       Panel.ZIndex="1"
                       IsHitTestVisible="True"
                       EditingMode="Ink"
                       Visibility="Collapsed"
                       ClipToBounds="True"/>
        </Grid>
        
        <!-- GeForce область (правая колонка) -->
        <Grid Grid.Column="1" x:Name="GeForceArea" Background="Transparent" ClipToBounds="True">
            <!-- Background Image (GeForce) -->
            <Image x:Name="GeForceBackgroundImage" 
                   Stretch="None" 
                   HorizontalAlignment="Left" 
                   VerticalAlignment="Top"
                   Panel.ZIndex="0"
                   IsHitTestVisible="False"/>
            
            <!-- InkCanvas для рисования поверх GeForce -->
            <InkCanvas x:Name="GeForceDrawingCanvas" 
                       Background="Transparent"
                       Panel.ZIndex="1"
                       IsHitTestVisible="True"
                       EditingMode="Ink"
                       ClipToBounds="True"/>
        </Grid>
        
        <!-- Active Symbol Display -->
        <Border x:Name="ActiveSymbolBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10"
                Background="#CC222222"
                BorderBrush="Black"
                BorderThickness="2"
                Padding="8,4"
                Panel.ZIndex="3">
            <TextBlock x:Name="ActiveSymbolText"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="Yellow"
                       Text=""
                       IsHitTestVisible="False"/>
        </Border>
        
        <!-- Copy to Clipboard Button -->
        <Button x:Name="CopyImageButton"
                Content="📋"
                Width="32" Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="150,10,0,0"
                Click="CopyImageButton_Click"
                ToolTip="Скопировать картинку в буфер"
                Background="#CC222222" Foreground="White"
                BorderBrush="Black" BorderThickness="1"
                FontSize="16"
                Panel.ZIndex="3"/>
        
        <TextBlock x:Name="TimerText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="10"
                   FontSize="24"
                   Foreground="White"
                   Background="#80000000"
                   Padding="8,4"
                   Text=""
                   Panel.ZIndex="3"
                   IsHitTestVisible="False"/>

        <!-- Центральный индикатор Trading Mode с брокером и риском -->
        <controls:TradingToolbar x:Name="TradingToolbar" 
                                 HorizontalAlignment="Center" 
                                 VerticalAlignment="Top" 
                                 Panel.ZIndex="3"
                                 Visibility="Collapsed" />

        <!-- Canvas Trading Toolbar - показывается при наличии открытых сделок -->
        <controls:CanvasTradingToolBar x:Name="CanvasTradingToolBar" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Top" 
                                       Margin="0,10,0,0"
                                       Panel.ZIndex="4"
                                       Visibility="Collapsed" />

        <!-- Canvas Tracking List - показывает список трекающихся CaptureData -->
        <controls:CanvasTrackingList x:Name="CanvasTrackingList" 
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Top" 
                                     Margin="0,5,0,0"
                                     Panel.ZIndex="5" />
    </Grid>
</Window>

