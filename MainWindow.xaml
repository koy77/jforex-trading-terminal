<Window x:Class="ScreenCaptureApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="White">
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,1">
            <!-- Два маленьких эллипса вертикально -->
            <Ellipse x:Name="CloseEllipse" Width="10" Height="10" Fill="Red" Stroke="Black" StrokeThickness="1" Cursor="Hand" MouseDown="CloseEllipse_MouseDown" Margin="0,4,0,0"/>
            <Ellipse x:Name="MinimizeEllipse" Width="10" Height="10" Fill="Gray" Stroke="Black" StrokeThickness="1" Cursor="Hand" MouseDown="MinimizeEllipse_MouseDown" Margin="0,18,8,0"/>
            <Button Content="Reset DB" Click="ResetDB_Click" Background="Red" Foreground="White" Padding="10,5" Margin="0,0,10,0"/>
            <ToggleButton x:Name="MenuToggleButton" Content="MENU" Width="70" Height="36" Background="Red" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                <ToggleButton x:Name="HotkeyToggleButton" Content="GHK" Click="HotkeyToggleButton_Click" Background="DarkGreen" Foreground="White" Padding="10,5"/>
                <Ellipse x:Name="HotkeyStatusIndicator" Width="20" Height="20" Stroke="Black" StrokeThickness="2" Fill="LimeGreen" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <Button Content="Лог" x:Name="RefreshLogButton" Click="RefreshLogButton_Click" Background="Gray" Foreground="White" Padding="10,5" Width="40" Height="32" Margin="0,0,10,0"/>
            <Button Content="Сбросить лог" x:Name="ResetLogButton" Click="ResetLogButton_Click" Background="DarkGray" Foreground="White" Padding="10,5" Width="90" Height="32" Margin="0,0,10,0"/>

            <Popup PlacementTarget="{Binding ElementName=MenuToggleButton}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=MenuToggleButton, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True">
                <Border Background="White" BorderBrush="Red" BorderThickness="2" CornerRadius="6" Padding="10" >
                    <StackPanel Orientation="Vertical" MinWidth="220">
                        
                        <Button Content="Run Capture Tracking" Click="RunCaptureTracking_Click" Background="Orange" Padding="10,5" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="AutoTrackingButton" Content="Auto Tracking" Click="AutoTrackingButton_Click" Background="DarkCyan" Foreground="White" Padding="10,5"/>
                            <Ellipse x:Name="AutoTrackingStatusIndicator" Width="20" Height="20" Stroke="Black" StrokeThickness="2" Fill="Red" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Reconnect MT4" Click="ReconnectMT4_Click" Background="DarkBlue" Foreground="White" Padding="10,5"/>
                            <Ellipse x:Name="SocketStatusIndicator" Width="20" Height="20" Stroke="Black" StrokeThickness="2" Fill="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Reconnect Binary Options" Click="ReconnectBinaryOptions_Click" Background="DarkOrange" Foreground="White" Padding="10,5"/>
                            <Ellipse x:Name="BinaryOptionsStatusIndicator" Width="20" Height="20" Stroke="Black" StrokeThickness="2" Fill="Gray" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="YellowBrushButton" Content="Yellow Brush" Click="YellowBrushButton_Click" Background="Yellow" Foreground="Black" Padding="10,5"/>
                            <Ellipse x:Name="YellowBrushIndicator" Width="20" Height="20" Stroke="Black" StrokeThickness="2" Fill="Yellow" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button x:Name="BlackBrushButton" Content="Black Brush" Click="BlackBrushButton_Click" Background="Black" Foreground="White" Padding="10,5" Margin="8,0,0,0"/>
                            <Ellipse x:Name="BlackBrushIndicator" Width="20" Height="20" Stroke="Black" StrokeThickness="2" Fill="Black" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <Grid>
                <Ellipse x:Name="XAUUSD_ActiveIndicator" Width="10" Height="10" Fill="Blue" Stroke="Black" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Button x:Name="XAUUSD" Content="XAUUSD" Tag="XAUUSD" Click="SymbolButton_Click" Background="Gold" Padding="8,4" Margin="2" MinWidth="70" Height="30"/>
            </Grid>
            <Grid>
                <Ellipse x:Name="GBPJPY_ActiveIndicator" Width="10" Height="10" Fill="Blue" Stroke="Black" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Button x:Name="GBPJPY" Content="GBPJPY" Tag="GBPJPY" Click="SymbolButton_Click" Background="LightCoral" Padding="8,4" Margin="2" MinWidth="70" Height="30"/>
            </Grid>
            <Grid>
                <Ellipse x:Name="EURUSD_ActiveIndicator" Width="10" Height="10" Fill="Blue" Stroke="Black" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Button x:Name="EURUSD" Content="EURUSD" Tag="EURUSD" Click="SymbolButton_Click" Background="LightBlue" Padding="8,4" Margin="2" MinWidth="70" Height="30"/>
            </Grid>
            <Grid>
                <Ellipse x:Name="USDJPY_ActiveIndicator" Width="10" Height="10" Fill="Blue" Stroke="Black" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Button x:Name="USDJPY" Content="USDJPY" Tag="USDJPY" Click="SymbolButton_Click" Background="LightGreen" Padding="8,4" Margin="2" MinWidth="70" Height="30"/>
            </Grid>
            <Grid>
                <Ellipse x:Name="GBPUSD_ActiveIndicator" Width="10" Height="10" Fill="Blue" Stroke="Black" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Button x:Name="GBPUSD" Content="GBPUSD" Tag="GBPUSD" Click="SymbolButton_Click" Background="LightPink" Padding="8,4" Margin="2" MinWidth="70" Height="30"/>
            </Grid>
            <Grid>
                <Ellipse x:Name="EURJPY_ActiveIndicator" Width="10" Height="10" Fill="Blue" Stroke="Black" StrokeThickness="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                <Button x:Name="EURJPY" Content="EURJPY" Tag="EURJPY" Click="SymbolButton_Click" Background="LightGreen" Padding="8,4" Margin="2" MinWidth="70" Height="30"/>
            </Grid>

            <!-- Symbol summary panel for MT4 orders summary, now inline -->
            <StackPanel x:Name="SymbolSummaryPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <TextBlock x:Name="TotalBalanceText" FontWeight="Bold" FontSize="16" Foreground="DarkGreen" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"/>

            <!-- <Button Content="Toggle Tracking Viewer" Click="ToggleTrackingViewer_Click" Background="Purple" Foreground="White" Padding="10,5" Margin="10,0,0,0"/> -->
        </StackPanel>

        <TextBox x:Name="LogTextBox" Grid.Row="4" Margin="0,0,0,10" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="NoWrap"/>
    </Grid>
</Window> 