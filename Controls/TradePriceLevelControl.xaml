<UserControl x:Class="ScreenCaptureApp.Controls.TradePriceLevelControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="350" d:DesignWidth="180">
    
    <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Символ -->
            <TextBlock x:Name="SymbolLabel" Grid.Row="0" 
                       Text="Symbol" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
            
             <!-- Кнопки риска -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                <Button x:Name="Risk1Button" Content="1" Tag="1" Width="30" Height="25" Margin="2" 
                        Background="#FFA500" Foreground="White" Click="RiskButton_Click"/>
                <Button x:Name="Risk5Button" Content="5" Tag="5" Width="30" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="RiskButton_Click"/>
                <Button x:Name="Risk10Button" Content="10" Tag="10" Width="30" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="RiskButton_Click"/>
                <Button x:Name="Risk20Button" Content="20" Tag="20" Width="30" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="RiskButton_Click"/>
                <Button x:Name="Risk30Button" Content="30" Tag="30" Width="30" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="RiskButton_Click"/>
            </StackPanel>
            
            <!-- Кнопки Take Profit -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                <Button x:Name="TP1xButton" Content="1x" Tag="1x" Width="35" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="TPButton_Click"/>
                <Button x:Name="TP2xButton" Content="2x" Tag="2x" Width="35" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="TPButton_Click"/>
                <Button x:Name="TP3xButton" Content="3x" Tag="3x" Width="35" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="TPButton_Click"/>
                <Button x:Name="TPInfButton" Content="inf" Tag="inf" Width="35" Height="25" Margin="2" 
                        Background="#4A4A4A" Foreground="White" Click="TPButton_Click"/>
            </StackPanel>

            
                        <!-- Place Sell (красным) -->
            <TextBlock Grid.Row="1" 
                       Text="Place Sell stop loss above" 
                       Foreground="#FF6B6B" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>
            
            <!-- Entry Level (зеленым) -->
            <TextBlock x:Name="EntryLevelLabel" Grid.Row="2" 
                       Text="0.00000" 
                       Foreground="#4ECDC4" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,5"/>

           
            
            <!-- Place Buy (синим) -->
            <TextBlock Grid.Row="5" 
                       Text="Place Buy stop loss below" 
                       Foreground="#74B9FF" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl> 