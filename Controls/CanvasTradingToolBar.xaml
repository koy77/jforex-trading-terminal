<UserControl x:Class="ScreenCaptureApp.Controls.CanvasTradingToolBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800">
    <Border Background="#CC222222" 
            BorderBrush="Transparent" 
            BorderThickness="0" 
            CornerRadius="5"
            Padding="10,5"
            Panel.ZIndex="1000">
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            
            <!-- Процент -->
            <TextBlock x:Name="PercentText" 
                       Text="0.3%" 
                       Foreground="Yellow" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,20,0"
                       VerticalAlignment="Center"/>
            
            <!-- Пункты -->
            <TextBlock x:Name="PointsText" 
                       Text="144pts" 
                       Foreground="Yellow" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Margin="0,0,20,0"
                       VerticalAlignment="Center"/>
            
            <!-- Кнопка BE -->
            <Button x:Name="BeButton" 
                    Content="[BE]" 
                    Background="#CC4444" 
                    Foreground="White" 
                    FontSize="24" 
                    FontWeight="Bold" 
                    Padding="15,8" 
                    BorderThickness="1" 
                    BorderBrush="#AA6666"
                    Cursor="Hand"
                    Click="BeButton_Click"
                    VerticalAlignment="Center"
                    Margin="0,0,10,0"/>
            
            <!-- Кнопка Sec -->
            <Button x:Name="SecButton" 
                    Content="[SEC]" 
                    Background="#CC4444" 
                    Foreground="White" 
                    FontSize="24" 
                    FontWeight="Bold" 
                    Padding="15,8" 
                    BorderThickness="1" 
                    BorderBrush="#AA6666"
                    Cursor="Hand"
                    Click="SecButton_Click"
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
