<UserControl x:Class="ScreenCaptureApp.Controls.TradeRectangleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="150">
    
    <Border Background="#AA222222" BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="10">
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            
            <!-- Symbol Display -->
            <TextBlock x:Name="SymbolLabel" Text="XAUUSD" 
                       Foreground="Cyan" FontWeight="Bold" FontSize="16" 
                       Background="#80000000" Padding="8,4" 
                       TextAlignment="Center" Margin="0,0,0,8"/>
            
            <!-- Upper Price and Buy Button -->
            <StackPanel Orientation="Vertical" Margin="0,0,0,8">
                <Button x:Name="BuyButton" Content="BUY" 
                        Width="100" Height="35" 
                        Background="Green" Foreground="White" 
                        FontSize="14" FontWeight="Bold" 
                        Click="BuyButton_Click" 
                        Cursor="Hand"/>
                <TextBlock x:Name="UpperPriceLabel" Text="Upper: 0.00000" 
                    Foreground="LightGreen" FontSize="14" FontWeight="Bold" 
                    Background="#80000000" Padding="8,4" 
                    TextAlignment="Center" Margin="0,0,0,4"/>
            </StackPanel>
            
            <!-- Lower Price and Sell Button -->
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="LowerPriceLabel" Text="Lower: 0.00000" 
                           Foreground="LightCoral" FontSize="14" FontWeight="Bold" 
                           Background="#80000000" Padding="8,4" 
                           TextAlignment="Center" Margin="0,0,0,4"/>
                <Button x:Name="SellButton" Content="SELL" 
                        Width="100" Height="35" 
                        Background="Red" Foreground="White" 
                        FontSize="14" FontWeight="Bold" 
                        Click="SellButton_Click" 
                        Cursor="Hand"/>
            </StackPanel>
            
        </StackPanel>
    </Border>
</UserControl> 