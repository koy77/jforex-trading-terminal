<UserControl x:Class="ScreenCaptureApp.Controls.OrderSymbol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="220">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Margin="4,0,4,0" Padding="8,4,8,4" Background="WhiteSmoke">
        <StackPanel Orientation="Vertical">
            <!-- Первая строка: символ, лоты, Close -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SymbolText" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock x:Name="LotsText" Foreground="DarkGreen" Margin="0,0,8,0"/>
                <Button x:Name="CloseButton" Content="Close" Margin="0,0,0,0" Padding="1,0,1,0" Background="OrangeRed" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
            <!-- Вторая строка: проценты, поинты, BE, TP1, TP2, TP3 -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock x:Name="PercentText" Foreground="DarkBlue" Margin="0,0,8,0"/>
                <TextBlock x:Name="PointsText" Foreground="DarkRed" Margin="0,0,8,0"/>
                <Button x:Name="BEButton" Content="BE" Margin="2,0,0,0" Padding="2,0,2,0" Background="LightGray" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                <Button x:Name="TP1Button" Content="TP1" Margin="2,0,0,0" Padding="2,0,2,0" Background="LightGray" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                <Button x:Name="TP2Button" Content="TP2" Margin="2,0,0,0" Padding="2,0,2,0" Background="LightGray" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
                <Button x:Name="TP3Button" Content="TP3" Margin="2,0,0,0" Padding="2,0,2,0" Background="LightGray" Foreground="Black" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl> 