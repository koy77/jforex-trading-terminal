<Window x:Class="ScreenCaptureApp.SimpleTradingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenCaptureApp.Controls"
        Title="Simple Trading Overlay" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    
    <Canvas x:Name="MainCanvas" Background="Transparent">
        <!-- Trading Toolbar - позиционируется справа -->
        <controls:TradingToolbar x:Name="TradingToolbar" 
                                 Canvas.Right="0" 
                                 Canvas.Top="0" 
                                 Panel.ZIndex="1000" />
        
        <!-- Yellow Trading Pattern Rectangle -->
        <Rectangle x:Name="TradingPatternRectangle" 
                   Stroke="Yellow" 
                   StrokeThickness="3" 
                   StrokeDashArray="4,2,1,2" 
                   Fill="Transparent"
                   Visibility="Collapsed"
                   Panel.ZIndex="999"/>
    </Canvas>
</Window> 