<Window x:Class="ScreenCaptureApp.SimpleTradingOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenCaptureApp.Controls"
        Title="SimpleTradingOverlay" 
        Height="100" 
        Width="1200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize">
    
    <Canvas x:Name="MainCanvas" Background="Transparent">
        <!-- TradingToolbar вверху окна -->
        <controls:TradingToolbar x:Name="TradingToolbar" 
                                 Canvas.Left="0" 
                                 Canvas.Top="0" 
                                 Panel.ZIndex="1000" />
    </Canvas>
</Window> 