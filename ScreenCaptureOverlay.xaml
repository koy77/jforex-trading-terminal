<Window x:Class="ScreenCaptureApp.ScreenCaptureOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ScreenCaptureApp.Controls"
        Title="Screen Capture Overlay" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp">
    
    <Canvas x:Name="CaptureCanvas" Background="#01000000"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Верхняя панель управления заменена на UserControl -->
        <controls:TradingToolbar x:Name="TradingToolbar" Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="1000" />
        
        <Rectangle x:Name="SelectionRectangle" 
                   Stroke="Yellow" 
                   StrokeThickness="3" 
                   StrokeDashArray="4,2,1,2" 
                   Fill="Transparent"
                   Visibility="Collapsed"/>
        
        <!-- Resize handles -->
        <Rectangle x:Name="TopLeftHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="TopRightHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="BottomLeftHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="BottomRightHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        
        <Rectangle x:Name="TopHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="BottomHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="LeftHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        <Rectangle x:Name="RightHandle" 
                   Width="8" Height="8" 
                   Fill="White" Stroke="Red" StrokeThickness="1"
                   Visibility="Collapsed"/>
        
        <TextBlock x:Name="CoordinatesText" 
                   Foreground="White" 
                   Background="#80000000"
                   Padding="5"
                   FontFamily="Consolas"
                   FontSize="12"
                   Visibility="Collapsed"/>
        
        <TextBlock x:Name="InstructionsText" 
                   Text="Нажмите и перетащите для выделения области. Enter - завершить (или создать выделение 100x100), Escape - отмена"
                   Foreground="White" 
                   Background="#80000000"
                   Padding="10"
                   FontSize="14"
                   Canvas.Left="10"
                   Canvas.Top="10"/>
        
        <TextBlock x:Name="SymbolLabel"
                   Foreground="Blue"
                   Background="#80FFFFFF"
                   FontWeight="Bold"
                   FontSize="20"
                   Visibility="Collapsed"
                   Text="SYMBOL"
                   Padding="4"
                   TextAlignment="Center"/>
    </Canvas>
</Window> 